{
  "name": "payload-4-boilerplate",
  "version": "1.0.0",
  "description": "Payload 4 + Next.js + PostgreSQL website template, ready for one-click deploys on Railway",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "start": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "deps:native": "corepack pnpm rebuild sharp esbuild",
    "e2e:install": "corepack pnpm install && corepack pnpm deps:native && corepack pnpm exec playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:manual": "cross-env PLAYWRIGHT_SLOW_MO=750 E2E_MANUAL_REVIEW=true playwright test --headed --workers=1"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "4.0.0-beta.2",
    "@payloadcms/db-postgres": "4.0.0-beta.2",
    "@payloadcms/email-nodemailer": "4.0.0-beta.2",
    "@payloadcms/live-preview-react": "4.0.0-beta.2",
    "@payloadcms/next": "4.0.0-beta.2",
    "@payloadcms/plugin-form-builder": "4.0.0-beta.2",
    "@payloadcms/plugin-mcp": "4.0.0-beta.2",
    "@payloadcms/plugin-redirects": "4.0.0-beta.2",
    "@payloadcms/plugin-search": "4.0.0-beta.2",
    "@payloadcms/plugin-seo": "4.0.0-beta.2",
    "@payloadcms/richtext-lexical": "4.0.0-beta.2",
    "@payloadcms/storage-s3": "4.0.0-beta.2",
    "@payloadcms/transformer-sharp": "4.0.0-beta.2",
    "@payloadcms/ui": "4.0.0-beta.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.4.2",
    "next-sitemap": "^4.2.3",
    "payload": "4.0.0-beta.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.71.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.2",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "oxfmt": "^0.73.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.0"
}
