# PostgreSQL connection string.
# Local: `docker compose up -d postgres` starts a matching database.
# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload

# Used to sign auth tokens. Use a long random string.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site. Used for CORS, links, SEO and live preview. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: lets an external cron trigger `/api/payload-jobs/run`.
# Not needed on Railway, where scheduled jobs run inside the app process.
CRON_SECRET=

# Optional: S3-compatible storage for uploads (Railway Bucket, AWS S3, Cloudflare R2, MinIO, ...).
# When S3_BUCKET is empty, uploads are stored on local disk in public/media.
# Local bucket: `docker compose up -d minio minio-init`, then use S3_BUCKET=payload,
# S3_ENDPOINT=http://127.0.0.1:9000, S3_REGION=us-east-1, S3_ACCESS_KEY_ID=payload,
# S3_SECRET_ACCESS_KEY=payload-secret and S3_FORCE_PATH_STYLE=true.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for MinIO and other providers that need path-style URLs
S3_FORCE_PATH_STYLE=false

# Optional: SMTP for password resets and other emails.
# When SMTP_HOST is empty, emails are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Payload
